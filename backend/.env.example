PORT=3001
NODE_ENV=production

# Database — PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://username:password@localhost:5432/nis_ai_school?schema=public"

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used by seeder)
ADMIN_EMAIL=admin@nis-ai.edu.uz
ADMIN_PASSWORD=your_secure_admin_password

# CORS & URLs
FRONTEND_URL=https://your-frontend.vercel.app,http://localhost:5173
BACKEND_URL=https://your-backend.railway.app

# Cloudinary (Optional Image Storage — Sign up at cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI Integration (Official SDK: @google/genai)
GEMINI_API_KEY=YOUR_NEW_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
